---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../components/Card.astro";
import TerminalWindow from "../components/TerminalWindow.astro";
import sageAvatar from "../assets/images/sagec.jpeg";
import { confidants } from "../data/confidants";

const milestones = [
  {
    period: "2022 - now",
    title: "BUPT / 人工智能 / 本科",
    detail: "正在学习人工智能，对 LLM、多模态、AI-infra 等感兴趣。",
  },
  {
    period: "2014",
    title: "Hello World!",
    detail: "Started playing with code.",
  },
];

const doing = [
  "全栈开发",
  "为 NAS 配置一点小服务，有意思的小工具",
  "写点有意思的小文章",
];

const contacts = [
  {
    label: "SEND MAIL",
    value: "sagecheni@outlook.com",
    href: "mailto:sagecheni@outlook.com",
  },
  {
    label: "GITHUB",
    value: "@Sagecheni",
    href: "https://github.com/Sagecheni",
  },
];
---

<BaseLayout
  title="About｜贤者工坊"
  description="About SageChen"
  author="SageChen"
  url="https://blog.sagec.fun/about"
>
  <div class="mx-auto max-w-[1280px] space-y-16 px-4 py-10">
    {/* WANTED 海报头像 */}
    <section class="landing-section flex flex-col items-center py-8">
      <div class="group relative cursor-pointer">
        {/* 悬停时浮现的海报衬底 */}
        <div
          class="bg-accent absolute -inset-8 z-0 rotate-2 opacity-0 transition-all duration-300 group-hover:opacity-100"
          style="clip-path: polygon(2% 0, 100% 2%, 98% 100%, 0% 98%)"
        >
        </div>
        <div
          class="bg-foreground absolute -inset-8 z-0 scale-[0.98] -rotate-1 opacity-0 transition-all duration-300 group-hover:opacity-100"
          style="clip-path: polygon(2% 0, 100% 2%, 98% 100%, 0% 98%)"
        >
        </div>

        {/* WANTED 字样 */}
        <div
          class="pointer-events-none absolute -top-20 left-1/2 z-20 w-[160%] -translate-x-1/2 text-center opacity-0 transition-all delay-75 duration-300 group-hover:translate-y-4 group-hover:opacity-100"
        >
          <span
            class="font-heading text-accent text-6xl tracking-widest drop-shadow-[4px_4px_0_var(--foreground)] md:text-7xl"
            style="-webkit-text-stroke: 2px var(--background);"
          >
            WANTED
          </span>
        </div>

        {/* 头像 */}
        <div
          class="relative z-30 mx-auto h-32 w-32 transition-transform duration-500 group-hover:scale-110 group-hover:rotate-3 md:h-40 md:w-40"
        >
          <div
            class="bg-accent/20 pointer-events-none absolute inset-0 z-20 rounded-full opacity-0 mix-blend-hard-light transition-opacity group-hover:opacity-100"
          >
          </div>
          <div
            class="from-accent to-foreground absolute inset-0 rounded-full bg-gradient-to-tr opacity-70 blur-xl transition-opacity group-hover:opacity-0"
          >
          </div>
          <Image
            src={sageAvatar}
            alt="SageChen"
            class="border-border relative h-full w-full rounded-full border-2 object-cover transition-all duration-700 ease-in-out group-hover:contrast-125 group-hover:grayscale"
          />

          {/* 囚号 */}
          <div
            class="absolute -right-10 -bottom-6 z-30 rotate-12 opacity-0 transition-all delay-100 duration-300 group-hover:opacity-100"
          >
            <span
              class="bg-foreground text-background border-background block -skew-x-12 border px-2 py-1 font-mono text-xs font-bold shadow-[2px_2px_0_var(--accent)]"
            >
              P.V. #001
            </span>
          </div>
        </div>

        {/* 名字 */}
        <div class="relative z-10 mt-6 h-16 text-center">
          <h1
            class="flex -skew-x-12 items-center justify-center gap-1 text-4xl tracking-widest md:text-5xl"
          >
            <span
              class="bg-accent block -rotate-2 px-3 py-1 text-white shadow-[4px_4px_0_var(--foreground)]"
              >S</span
            >
            <span
              class="bg-background text-foreground border-foreground z-10 block scale-110 rotate-3 border-2 px-3 py-1 shadow-[4px_4px_0_var(--accent)]"
              >A</span
            >
            <span
              class="bg-accent block -rotate-1 px-3 py-1 text-white shadow-[4px_4px_0_var(--foreground)]"
              >G</span
            >
            <span
              class="bg-accent block rotate-2 px-3 py-1 text-white shadow-[4px_4px_0_var(--foreground)]"
              >E</span
            >
          </h1>
        </div>
      </div>
    </section>

    {/* 终端 */}
    <section class="landing-section delay-100">
      <TerminalWindow title="root@sage:~">
        <div class="space-y-6 text-sm md:text-base">
          <div class="space-y-2">
            <div class="flex gap-2 font-bold text-zinc-300">
              <span class="text-[#d8000c]">root@sage:~$</span>
              <span>whoami</span>
            </div>
            <div class="ml-1 border-l-2 border-white/5 pl-4 text-zinc-300">
              SageChen (WENHUI CHEN)
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex gap-2 font-bold text-zinc-300">
              <span class="text-[#d8000c]">root@sage:~$</span>
              <span>check -d 2026 --short</span>
            </div>
            <div class="ml-1 border-l-2 border-white/5 pl-4 text-zinc-300">
              北京邮电大学 / 人工智能 / MCPRL
            </div>
          </div>

          <div class="space-y-2">
            <div class="flex gap-2 font-bold text-zinc-300">
              <span class="text-[#d8000c]">root@sage:~$</span>
              <span>open github</span>
            </div>
            <div class="ml-1 border-l-2 border-white/5 pl-4">
              <a
                href="https://github.com/Sagecheni"
                target="_blank"
                rel="noopener noreferrer"
                class="text-[#d8000c] underline decoration-white/30 underline-offset-4 transition-all hover:text-white"
                >github.com/Sagecheni</a
              >
            </div>
          </div>

          <div class="flex gap-2 pt-2 font-bold text-zinc-300">
            <span class="text-[#d8000c]">root@sage:~$</span>
            <span class="animate-blink mt-0.5 block h-5 w-2.5 bg-zinc-400"
            ></span>
          </div>
        </div>
      </TerminalWindow>
    </section>

    {/* 内容栅格 */}
    <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
      {/* Milestones */}
      <section class="landing-section delay-100 md:col-span-7">
        <Card title="Milestones" class="h-full">
          <div
            class="before:bg-border relative space-y-8 before:absolute before:inset-y-0 before:left-[7px] before:w-0.5"
          >
            {
              milestones.map((item) => (
                <div class="relative pl-8">
                  <div class="bg-background border-accent absolute top-1.5 left-0 z-10 h-4 w-4 rotate-45 border-2" />
                  <div class="space-y-1">
                    <div class="text-accent font-mono text-sm font-bold">
                      {item.period}
                    </div>
                    <div class="text-foreground font-medium">{item.title}</div>
                    <p class="text-foreground-secondary text-sm">
                      {item.detail}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </Card>
      </section>

      {/* 右列 */}
      <div class="space-y-6 md:col-span-5">
        {/* What I do */}
        <section class="landing-section delay-200">
          <Card title="What I do">
            <ul class="m-0 list-none space-y-3 p-0">
              {
                doing.map((item) => (
                  <li class="text-foreground-secondary flex items-start gap-3">
                    <span class="bg-accent mt-1.5 block h-2 w-2 shrink-0 rotate-45" />
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </Card>
        </section>

        {/* Skills — 涂鸦贴纸 */}
        <section class="landing-section delay-300">
          <Card title="Skills">
            <div class="flex flex-wrap justify-center gap-3 p-2">
              {
                confidants.map((skill, index) => {
                  const rotation = [
                    "-rotate-3",
                    "rotate-2",
                    "-rotate-1",
                    "rotate-3",
                    "-rotate-2",
                  ][index % 5];
                  // 三种贴纸样式轮换：黑 / 白 / 红
                  const styleType = index % 3;
                  const skin =
                    styleType === 1
                      ? "bg-background text-foreground border-foreground shadow-[2px_2px_0_var(--foreground)]"
                      : styleType === 2
                        ? "bg-accent text-white border-foreground shadow-[2px_2px_0_var(--foreground)]"
                        : "bg-foreground text-background border-accent shadow-[2px_2px_0_var(--accent)]";
                  const dotOn = styleType === 0 ? "bg-accent" : "bg-foreground";
                  const dotOff = "bg-foreground-secondary opacity-40";

                  return (
                    <div
                      class={`group relative border-2 px-3 py-1.5 ${skin} transform ${rotation} cursor-default transition-all duration-300 select-none hover:z-10 hover:scale-110 hover:rotate-0`}
                    >
                      <div class="flex flex-col items-center">
                        <span class="font-heading text-lg leading-none tracking-widest">
                          {skill.name}
                        </span>
                        <div class="mt-1 flex gap-1">
                          {Array.from({ length: 5 }).map((_, i) => (
                            <div
                              class={`h-1 w-1 rounded-full ${i < skill.rank ? dotOn : dotOff}`}
                            />
                          ))}
                        </div>
                      </div>
                    </div>
                  );
                })
              }
            </div>
          </Card>
        </section>

        {/* Contact — 预告函 */}
        <section class="landing-section delay-400">
          <div class="group relative py-4">
            <div
              class="relative transition-transform duration-500 group-hover:scale-[1.02] group-hover:rotate-1"
            >
              <div
                class="bg-accent border-foreground relative z-10 border-4 border-dashed p-6 shadow-xl"
                style="clip-path: polygon(2% 0, 98% 2%, 100% 98%, 0% 100%);"
              >
                <div class="relative z-10 space-y-4 pt-4">
                  {
                    contacts.map((contact) => (
                      <a
                        href={contact.href}
                        target={
                          contact.href.startsWith("http") ? "_blank" : null
                        }
                        rel={
                          contact.href.startsWith("http")
                            ? "noopener noreferrer"
                            : null
                        }
                        class="group/link bg-foreground text-background border-background hover:bg-background hover:text-foreground hover:border-foreground block -skew-x-6 border-2 p-3 transition-all hover:skew-x-0"
                      >
                        <div class="flex items-center justify-between font-mono font-bold">
                          <span>{contact.label}</span>
                          <span class="group-hover/link:animate-blink">_</span>
                        </div>
                        <div class="mt-1 text-xs opacity-70">
                          {contact.value}
                        </div>
                      </a>
                    ))
                  }
                </div>

                {/* 旋转装饰 */}
                <div
                  class="pointer-events-none absolute right-2 bottom-2 opacity-50"
                >
                  <svg
                    width="60"
                    height="60"
                    viewBox="0 0 100 100"
                    class="animate-spin-slow"
                  >
                    <path
                      d="M50 0 L100 50 L50 100 L0 50 Z"
                      fill="none"
                      stroke="var(--foreground)"
                      stroke-width="2"></path>
                  </svg>
                </div>
              </div>

              {/* 剪贴报头 */}
              <div
                class="bg-foreground text-background border-background pointer-events-none absolute -top-4 -right-2 z-20 rotate-12 border-2 px-4 py-2 text-xl font-black shadow-lg"
              >
                CONTACT ME!!
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>
