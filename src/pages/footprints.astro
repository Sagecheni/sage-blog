---
import BaseLayout from "../layouts/BaseLayout.astro";
import { footprints } from "../data/footprints";

// 底图是 1600×800 的完整等距圆柱投影（经度 -180..180，纬度 -90..90），
// 经纬度 → 百分比是纯线性映射
const xOf = (lng: number) => ((lng + 180) / 360) * 100;
const yOf = (lat: number) => ((90 - lat) / 180) * 100;
---

<BaseLayout
  title="足迹｜贤者工坊"
  description="去过的地方"
  author="SageChen"
  url="https://blog.sagec.fun/footprints"
>
  <div class="mx-auto w-full max-w-[1100px] px-4 py-6">
    <header class="blog-hero">
      <h1 class="blog-hero-title font-heading">FOOTPRINTS</h1>
      <p class="blog-hero-hand font-hand" aria-hidden="true">
        {footprints.length} 个地方，慢慢多起来
      </p>
    </header>

    {/* 地图 */}
    <div
      class="footprints-map card landing-section relative overflow-hidden p-0"
    >
      <img
        src="/world-map.webp"
        alt="世界地图"
        width="1600"
        height="800"
        class="block h-auto w-full select-none"
        loading="eager"
        decoding="async"
      />
      {
        footprints.map((fp) => {
          const style = `left:${xOf(fp.lng).toFixed(2)}%;top:${yOf(fp.lat).toFixed(2)}%;`;
          const label = `${fp.place} · ${fp.date}`;
          return fp.slug ? (
            <a
              href={`/blog/${fp.slug}`}
              class="fp-dot"
              style={style}
              aria-label={label}
            >
              <span class="fp-pulse" aria-hidden="true" />
              <span class="fp-tip">{label}</span>
            </a>
          ) : (
            <span class="fp-dot" style={style} aria-label={label} tabindex="0">
              <span class="fp-pulse" aria-hidden="true" />
              <span class="fp-tip">{label}</span>
            </span>
          );
        })
      }
    </div>

    {/* 列表（移动端地图点太小，这里保底） */}
    <ul
      class="landing-section m-0 mt-6 grid list-none grid-cols-1 gap-3 p-0 delay-100 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        footprints.map((fp) => (
          <li>
            {fp.slug ? (
              <a href={`/blog/${fp.slug}`} class="card group block p-4">
                <span class="card-notch" aria-hidden="true" />
                <span class="font-heading group-hover:text-accent text-lg tracking-wide transition-colors">
                  {fp.place}
                </span>
                <span class="text-foreground-secondary mt-1 block font-mono text-xs">
                  {fp.date}
                </span>
                {fp.note && (
                  <span class="text-foreground-secondary mt-1 block text-sm">
                    {fp.note}
                  </span>
                )}
              </a>
            ) : (
              <div class="card p-4">
                <span class="card-notch" aria-hidden="true" />
                <span class="font-heading text-lg tracking-wide">
                  {fp.place}
                </span>
                <span class="text-foreground-secondary mt-1 block font-mono text-xs">
                  {fp.date}
                </span>
                {fp.note && (
                  <span class="text-foreground-secondary mt-1 block text-sm">
                    {fp.note}
                  </span>
                )}
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <p class="text-foreground-secondary/60 mt-8 text-center font-mono text-xs">
      底图：<a
        href="https://commons.wikimedia.org/wiki/File:World_location_map_(equirectangular_180).svg"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent underline">TUBS / Wikimedia Commons</a
      >（CC BY-SA 3.0，灰度栅格化）
    </p>
  </div>
</BaseLayout>

<style>
  /* 暗色主题反相底图：白海变黑海 */
  :global(html.dark) .footprints-map img {
    filter: invert(1) brightness(0.8);
  }

  /* 容器不旋转（提示框才不歪），菱形交给 ::before */
  .fp-dot {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    cursor: pointer;
  }

  .fp-dot::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--accent);
    border: 2px solid var(--background);
    transform: rotate(45deg);
  }

  .fp-pulse {
    position: absolute;
    inset: -6px;
    border: 2px solid var(--accent);
    transform: rotate(45deg);
    opacity: 0;
    animation: fp-pulse 2.4s ease-out infinite;
  }

  @keyframes fp-pulse {
    0% {
      opacity: 0.9;
      transform: scale(0.4);
    }
    100% {
      opacity: 0;
      transform: scale(1.6);
    }
  }

  .fp-tip {
    position: absolute;
    bottom: 140%;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.15rem 0.5rem;
    background-color: var(--accent);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms var(--motion-ease-standard);
  }

  .fp-dot:hover .fp-tip,
  .fp-dot:focus-visible .fp-tip {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .fp-pulse {
      animation: none;
    }
  }
</style>
