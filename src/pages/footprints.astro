---
import BaseLayout from "../layouts/BaseLayout.astro";
import { footprints } from "../data/footprints";
import { getPublishedBlogs } from "../data/blog";

// ── 两套视图的经纬度 → 百分比线性映射 ──
// 世界：完整等距圆柱投影（1600×800，经 -180..180 / 纬 -90..90）
// 中国：同源裁切（1400×813，经 73..135 / 纬 18..54）
const CHINA = { lngMin: 73, lngMax: 135, latMin: 18, latMax: 54 };

const worldX = (lng: number) => ((lng + 180) / 360) * 100;
const worldY = (lat: number) => ((90 - lat) / 180) * 100;
const chinaX = (lng: number) =>
  ((lng - CHINA.lngMin) / (CHINA.lngMax - CHINA.lngMin)) * 100;
const chinaY = (lat: number) =>
  ((CHINA.latMax - lat) / (CHINA.latMax - CHINA.latMin)) * 100;
const inChina = (fp: { lat: number; lng: number }) =>
  fp.lng >= CHINA.lngMin &&
  fp.lng <= CHINA.lngMax &&
  fp.lat >= CHINA.latMin &&
  fp.lat <= CHINA.latMax;

// ── 游记标题解析（slug 写错会产出坏链接 → 构建期死链检查直接失败，故意的）──
const blogs = await getPublishedBlogs();
const titleOf = new Map(blogs.map((b) => [b.data.slug, b.data.title]));

// ── 自动足迹：带 location frontmatter 的游记自动生成足迹并与手动条目合并。
//    同地多篇归并 posts（按日期升序）；与手动条目同名时手动字段优先、posts 合并 ──
const fmtMonth = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`;

const autoByPlace = new Map<
  string,
  { lat: number; lng: number; first: Date; posts: string[]; trip?: string }
>();
for (const b of [...blogs].sort(
  (a, z) => a.data.date.getTime() - z.data.date.getTime(),
)) {
  const loc = b.data.location;
  if (!loc) continue;
  const entry = autoByPlace.get(loc.place);
  if (entry) {
    entry.posts.push(b.data.slug);
    entry.trip ??= b.data.series;
  } else {
    autoByPlace.set(loc.place, {
      lat: loc.lat,
      lng: loc.lng,
      first: b.data.date,
      posts: [b.data.slug],
      trip: b.data.series,
    });
  }
}

const merged = footprints.map((fp) => {
  const auto = autoByPlace.get(fp.place);
  if (!auto) return fp;
  autoByPlace.delete(fp.place);
  return {
    ...fp,
    posts: [...new Set([...(fp.posts ?? []), ...auto.posts])],
    trip: fp.trip ?? auto.trip,
  };
});
for (const [place, auto] of autoByPlace) {
  merged.push({
    place,
    lat: auto.lat,
    lng: auto.lng,
    date: fmtMonth(auto.first),
    posts: auto.posts,
    trip: auto.trip,
  });
}
const allFootprints = merged;

// ── 统计 ──
const visited = allFootprints.filter((fp) => !fp.planned);
const planned = allFootprints.filter((fp) => fp.planned);

// 最远足迹：以北京为原点的球面距离
const HOME = { lat: 39.9042, lng: 116.4074 };
function distanceKm(a: { lat: number; lng: number }) {
  const rad = (d: number) => (d * Math.PI) / 180;
  const dLat = rad(a.lat - HOME.lat);
  const dLng = rad(a.lng - HOME.lng);
  const h =
    Math.sin(dLat / 2) ** 2 +
    Math.cos(rad(HOME.lat)) * Math.cos(rad(a.lat)) * Math.sin(dLng / 2) ** 2;
  return Math.round(6371 * 2 * Math.asin(Math.sqrt(h)));
}
const farthest = visited
  .map((fp) => ({ fp, km: distanceKm(fp) }))
  .sort((a, b) => b.km - a.km)[0];

// ── 旅行路线：同 trip 的点按数组顺序连线（每个视图分别算像素坐标）──
const trips = new Map<string, typeof allFootprints>();
for (const fp of allFootprints) {
  if (!fp.trip) continue;
  if (!trips.has(fp.trip)) trips.set(fp.trip, []);
  trips.get(fp.trip)!.push(fp);
}
const worldRoutes = [...trips.values()]
  .filter((points) => points.length >= 2)
  .map((points) =>
    points
      .map(
        (p) =>
          `${(worldX(p.lng) * 16).toFixed(1)},${(worldY(p.lat) * 8).toFixed(1)}`,
      )
      .join(" "),
  );
const chinaRoutes = [...trips.values()]
  .map((points) => points.filter(inChina))
  .filter((points) => points.length >= 2)
  .map((points) =>
    points
      .map(
        (p) =>
          `${(chinaX(p.lng) * 14).toFixed(1)},${(chinaY(p.lat) * 8.13).toFixed(1)}`,
      )
      .join(" "),
  );

// 默认视图：境内有点显中国，否则世界
const defaultView = allFootprints.some(inChina) ? "china" : "world";

const views = [
  {
    id: "china",
    label: "中国",
    src: "/china-map.webp",
    width: 1400,
    height: 813,
    viewBox: "0 0 1400 813",
    routes: chinaRoutes,
    dots: allFootprints.filter(inChina).map((fp) => ({
      fp,
      x: chinaX(fp.lng),
      y: chinaY(fp.lat),
    })),
  },
  {
    id: "world",
    label: "世界",
    src: "/world-map.webp",
    width: 1600,
    height: 800,
    viewBox: "0 0 1600 800",
    routes: worldRoutes,
    dots: allFootprints.map((fp) => ({
      fp,
      x: worldX(fp.lng),
      y: worldY(fp.lat),
    })),
  },
];
---

<BaseLayout
  title="足迹｜贤者工坊"
  description="去过的地方"
  author="SageChen"
  url="https://blog.sagec.fun/footprints"
>
  <div class="mx-auto w-full max-w-[1100px] px-4 py-6">
    <header class="blog-hero">
      <h1 class="blog-hero-title font-heading">FOOTPRINTS</h1>
      <p class="blog-hero-hand font-hand" aria-hidden="true">
        {allFootprints.length} 个地方，慢慢多起来
      </p>

      {/* 统计行 */}
      <p
        class="text-foreground-secondary mt-4 font-mono text-xs tracking-widest"
      >
        去过 <span class="text-accent font-bold">{visited.length}</span> 地 · 想去
        <span class="text-accent font-bold">{planned.length}</span> 地{
          farthest && farthest.km > 0 && (
            <>
              {" "}
              · 最远抵达{" "}
              <span class="text-accent font-bold">{farthest.fp.place}</span>（
              {farthest.km} km）
            </>
          )
        }
      </p>

      {/* 视图切换 */}
      <div
        class="mt-5 flex items-center justify-center gap-2"
        role="group"
        aria-label="地图视图"
      >
        {
          views.map((view) => (
            <button
              type="button"
              class:list={[
                "fp-toggle -skew-x-12 border-2 px-4 py-1 text-sm font-bold transition-colors",
                view.id === defaultView && "is-active",
              ]}
              data-view-btn={view.id}
              aria-pressed={view.id === defaultView ? "true" : "false"}
            >
              <span class="block skew-x-12">{view.label}</span>
            </button>
          ))
        }
      </div>
    </header>

    {/* 地图（两套视图，切换显隐） */}
    {
      views.map((view) => (
        <div
          class:list={[
            "fp-view footprints-map card landing-section relative overflow-hidden p-0",
            view.id !== defaultView && "hidden",
          ]}
          data-view={view.id}
        >
          <img
            src={view.src}
            alt={`${view.label}地图`}
            width={view.width}
            height={view.height}
            class="fp-base block h-auto w-full select-none"
            loading={view.id === defaultView ? "eager" : "lazy"}
            decoding="async"
          />

          {/* 省份点亮层 —— 独立于底图，不参与暗色反相（红反相会变青） */}
          {view.id === "china" && (
            <img
              src="/china-lit.webp"
              alt=""
              width={view.width}
              height={view.height}
              class="pointer-events-none absolute inset-0 h-full w-full"
              loading={view.id === defaultView ? "eager" : "lazy"}
              decoding="async"
              aria-hidden="true"
            />
          )}

          {/* 旅行路线 */}
          {view.routes.length > 0 && (
            <svg
              class="pointer-events-none absolute inset-0 h-full w-full"
              viewBox={view.viewBox}
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              {view.routes.map((points) => (
                <polyline
                  points={points}
                  fill="none"
                  stroke="var(--accent)"
                  stroke-width="2.5"
                  stroke-dasharray="7 5"
                  opacity="0.55"
                />
              ))}
            </svg>
          )}

          {/* 地点 */}
          {view.dots.map(({ fp, x, y }) => {
            const style = `left:${x.toFixed(2)}%;top:${y.toFixed(2)}%;`;
            const label = `${fp.place} · ${fp.date}`;
            const href = fp.posts?.[0] ? `/blog/${fp.posts[0]}` : null;
            return href ? (
              <a
                href={href}
                class:list={["fp-dot", fp.planned && "planned"]}
                style={style}
                aria-label={label}
                data-place={fp.place}
              >
                <span class="fp-tip">{label}</span>
              </a>
            ) : (
              <span
                class:list={["fp-dot", fp.planned && "planned"]}
                style={style}
                aria-label={label}
                data-place={fp.place}
                tabindex="0"
              >
                <span class="fp-tip">{label}</span>
              </span>
            );
          })}
        </div>
      ))
    }

    {/* 图例 */}
    <div
      class="text-foreground-secondary mt-3 flex items-center justify-center gap-6 font-mono text-xs"
      aria-hidden="true"
    >
      <span class="flex items-center gap-2">
        <span
          class="bg-accent border-background inline-block h-2.5 w-2.5 rotate-45 border"
        ></span> 去过
      </span>
      <span class="flex items-center gap-2">
        <span class="border-accent inline-block h-2.5 w-2.5 rotate-45 border-2"
        ></span> 想去
      </span>
      {
        trips.size > 0 && (
          <span class="flex items-center gap-2">
            <span
              class="inline-block h-0 w-6 border-t-2 border-dashed"
              style="border-color: var(--accent);"
            />
            旅行路线
          </span>
        )
      }
    </div>

    {/* 列表 */}
    <ul
      class="landing-section m-0 mt-6 grid list-none grid-cols-1 gap-3 p-0 delay-100 sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        allFootprints.map((fp) => (
          <li>
            <div class="card group relative overflow-hidden p-0">
              <span class="card-notch" aria-hidden="true" />
              {fp.photo && (
                <img
                  src={fp.photo}
                  alt={fp.place}
                  class="h-28 w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="p-4">
                <div class="flex items-baseline justify-between gap-2">
                  <span class="font-heading text-lg tracking-wide">
                    {fp.place}
                  </span>
                  {fp.planned && (
                    <span class="border-accent text-accent -skew-x-12 border px-1.5 py-0.5 text-xs font-bold">
                      <span class="block skew-x-12">想去</span>
                    </span>
                  )}
                </div>
                <span class="text-foreground-secondary mt-1 block font-mono text-xs">
                  {fp.date}
                  {fp.trip && <> · {fp.trip}</>}
                </span>
                {fp.note && (
                  <span class="text-foreground-secondary mt-1 block text-sm">
                    {fp.note}
                  </span>
                )}
                {fp.posts && fp.posts.length > 0 && (
                  <span class="mt-2 flex flex-col gap-1">
                    {fp.posts.map((slug) => (
                      <a
                        href={`/blog/${slug}`}
                        class="text-accent text-sm hover:underline"
                      >
                        → {titleOf.get(slug) ?? slug}
                      </a>
                    ))}
                  </span>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>

    <p class="text-foreground-secondary/60 mt-8 text-center font-mono text-xs">
      底图构建期自渲染 · 世界：<a
        href="https://www.naturalearthdata.com/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent underline">Natural Earth</a
      >（公有领域，无国界剪影）· 中国：<a
        href="https://datav.aliyun.com/portal/school/atlas/area_selector"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent underline">DataV.GeoAtlas</a
      >（高德标准画法）
    </p>
  </div>
</BaseLayout>

<style>
  /* 暗色主题反相底图（仅 .fp-base —— 点亮层的红不能被反成青） */
  :global(html.dark) .footprints-map img.fp-base {
    filter: invert(1) brightness(0.8);
  }

  /* 切换钮：状态全部收进 CSS —— 拆开写 Tailwind hover 类会在
     「激活 + 悬停」时红字撞红底隐形 */
  .fp-toggle {
    border-color: var(--border);
  }

  .fp-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .fp-toggle.is-active,
  .fp-toggle.is-active:hover {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #ffffff;
  }

  /* 容器不旋转（提示框才不歪），菱形交给 ::before */
  .fp-dot {
    position: absolute;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    cursor: pointer;
  }

  .fp-dot::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--accent);
    border: 2px solid var(--background);
    transform: rotate(45deg);
  }

  /* 想去：空心点 */
  .fp-dot.planned::before {
    background-color: transparent;
    border: 2px solid var(--accent);
  }

  /* ?focus= 联动：目标点放大 + 提示框常显 */
  .fp-dot.is-focus::before {
    transform: rotate(45deg) scale(1.6);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .fp-dot.is-focus .fp-tip {
    opacity: 1;
  }

  .fp-tip {
    position: absolute;
    bottom: 140%;
    left: 50%;
    transform: translateX(-50%);
    padding: 0.15rem 0.5rem;
    background-color: var(--accent);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms var(--motion-ease-standard);
    z-index: 5;
  }

  .fp-dot:hover .fp-tip,
  .fp-dot:focus-visible .fp-tip {
    opacity: 1;
  }
</style>

<script>
  // 世界 ⇄ 中国 视图切换（每页元素重绑，dataset 守卫防重入）
  function initFootprints() {
    const buttons = document.querySelectorAll<HTMLElement>("[data-view-btn]");
    if (!buttons.length) return;
    if (buttons[0].dataset.bound === "true") return;
    buttons[0].dataset.bound = "true";

    function showView(target: string) {
      document.querySelectorAll<HTMLElement>(".fp-view").forEach((view) => {
        view.classList.toggle("hidden", view.dataset.view !== target);
      });
      buttons.forEach((btn) => {
        const active = btn.dataset.viewBtn === target;
        btn.classList.toggle("is-active", active);
        btn.setAttribute("aria-pressed", String(active));
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => showView(btn.dataset.viewBtn!));
    });

    // ?focus=地名 —— 文章位置徽章跳转过来：高亮目标点、必要时切视图、滚到地图
    const focus = new URLSearchParams(location.search).get("focus");
    if (focus) {
      const dots = [
        ...document.querySelectorAll<HTMLElement>(".fp-dot"),
      ].filter((dot) => dot.dataset.place === focus);
      if (dots.length) {
        dots.forEach((dot) => dot.classList.add("is-focus"));
        // 目标只存在于非默认视图（如境外点）时切过去
        const container = dots[0].closest<HTMLElement>(".fp-view");
        const visible = dots.some(
          (dot) => !dot.closest(".fp-view")?.classList.contains("hidden"),
        );
        if (!visible && container?.dataset.view) {
          showView(container.dataset.view);
        }
        document
          .querySelector(".fp-view:not(.hidden)")
          ?.scrollIntoView({ block: "center" });
      }
    }
  }

  document.addEventListener("DOMContentLoaded", initFootprints);
  document.addEventListener("astro:page-load", initFootprints);
</script>
