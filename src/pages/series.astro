---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedBlogs } from "../data/blog";
import type { BlogType } from "../content.config";

const blogs = await getPublishedBlogs();

// 按系列名分组，组内按日期升序（与文章页系列卡一致）
const bySeries = new Map<string, BlogType[]>();
for (const blog of blogs) {
  const name = blog.data.series;
  if (!name) continue;
  if (!bySeries.has(name)) bySeries.set(name, []);
  bySeries.get(name)!.push(blog);
}
const seriesList = [...bySeries.entries()]
  .map(([name, posts]) => ({
    name,
    posts: posts.sort((a, b) => a.data.date.getTime() - b.data.date.getTime()),
  }))
  // 最近更新的系列排前面
  .sort(
    (a, b) =>
      b.posts[b.posts.length - 1].data.date.getTime() -
      a.posts[a.posts.length - 1].data.date.getTime(),
  );

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<BaseLayout
  title="系列｜贤者工坊"
  description="连载系列总览"
  author="SageChen"
  url="https://blog.sagec.fun/series"
>
  <div class="mx-auto w-full max-w-3xl px-4 py-6">
    <header class="blog-hero">
      <h1 class="blog-hero-title font-heading">SERIES</h1>
      <p class="blog-hero-hand font-hand" aria-hidden="true">连载与专题</p>
    </header>

    {
      seriesList.length === 0 ? (
        <div class="card landing-section mx-auto max-w-md p-8 text-center">
          <p class="font-heading text-foreground-secondary m-0 text-xl tracking-wider">
            还没有连载
          </p>
          <p class="text-foreground-secondary mt-2 text-sm">
            给两篇以上的文章写上同一个
            <code class="text-accent">series</code> 字段，它们就会出现在这里。
          </p>
        </div>
      ) : (
        <div class="landing-section space-y-6">
          {seriesList.map((series) => (
            <section class="card p-5 md:p-6">
              <span class="card-notch" aria-hidden="true" />
              <div class="mb-3 flex items-baseline justify-between gap-3">
                <h2 class="font-heading text-accent m-0 text-2xl tracking-wider">
                  {series.name}
                </h2>
                <span class="text-foreground-secondary font-mono text-xs tracking-widest">
                  {series.posts.length} 篇 ·{" "}
                  {formatDate(series.posts[series.posts.length - 1].data.date)}
                  更新
                </span>
              </div>
              <ol class="m-0 list-none space-y-1.5 p-0">
                {series.posts.map((blog, index) => (
                  <li class="flex items-baseline gap-3">
                    <span class="text-foreground-secondary font-mono text-xs">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                    <a
                      href={`/blog/${blog.data.slug}`}
                      class="text-foreground hover:text-accent transition-colors"
                    >
                      {blog.data.title}
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>
