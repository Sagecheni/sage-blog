---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import BlogFilters from "../../components/BlogFilters.astro";
import Tag from "../../components/Tag.astro";
import { getPublishedBlogs } from "../../data/blog";
import type { ArchiveYear } from "../../components/BlogFilters.astro";
import IconFilter from "../../assets/icons/tag.svg";
import IconX from "../../assets/icons/x.svg";

function monthKey(date: Date) {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, "0");
  return `${y}-${m}`;
}

function removeMarkdown(markdown: string) {
  if (!markdown) return "";
  return markdown
    .replace(/!\[.*?\]\(.*?\)/g, "")
    .replace(/\[([^\]]+)\]\(.*?\)/g, "$1")
    .replace(/#{1,6}\s/g, "")
    .replace(/(\*|_){1,3}([^*_]+)(\*|_){1,3}/g, "$2")
    .replace(/`{1,3}[^`]*`{1,3}/g, "")
    .replace(/^\s*[-+*]\s/gm, "")
    .replace(/^\s*>\s/gm, "")
    .replace(/\n+/g, " ")
    .trim();
}

// 共享数据层：定时发布过滤 + 日期降序；置顶的提到最前（组内仍按日期）
const published = await getPublishedBlogs();
const allBlogs = [
  ...published.filter((b) => b.data.pinned),
  ...published.filter((b) => !b.data.pinned),
];

// 1. 标签计数
const tagCounts = new Map<string, number>();
allBlogs.forEach((blog) => {
  blog.data.tags.forEach((tag) => {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  });
});
const sortedTags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

// 2. 归档树（年 → 月）
const archiveMap = new Map<
  string,
  ArchiveYear & { months: (ArchiveYear["months"][number] & { date: Date })[] }
>();

allBlogs.forEach((blog) => {
  const y = blog.data.date.getFullYear().toString();
  const ym = monthKey(blog.data.date);

  if (!archiveMap.has(y)) {
    archiveMap.set(y, { year: y, count: 0, months: [] });
  }
  const yearEntry = archiveMap.get(y)!;
  yearEntry.count++;

  let monthEntry = yearEntry.months.find((m) => m.ym === ym);
  if (!monthEntry) {
    const date = new Date(blog.data.date);
    monthEntry = {
      ym,
      name: date.toLocaleString("default", { month: "long" }),
      count: 0,
      date,
    };
    yearEntry.months.push(monthEntry);
  }
  monthEntry.count++;
});

const archiveTree: ArchiveYear[] = [...archiveMap.values()]
  .sort((a, b) => parseInt(b.year) - parseInt(a.year))
  .map((y) => {
    y.months.sort((a, b) => b.date.getTime() - a.date.getTime());
    return y;
  });
---

<BaseLayout
  title="Blog｜贤者工坊"
  description="SageChen 的全部文章"
  author="SageChen"
  url="https://blog.sagec.fun/blog"
>
  <div class="mx-auto w-full max-w-[1400px] px-4 py-6 md:px-8">
    <header class="blog-hero">
      <h1 class="blog-hero-title font-heading">BLOG</h1>
      <p class="blog-hero-hand font-hand" aria-hidden="true">
        技术笔记 & 胡思乱想
      </p>
    </header>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_3fr]">
      {/* 桌面侧栏 */}
      <aside class="hidden lg:block">
        <div class="sticky top-[calc(var(--nav-height)+1rem)]">
          <Card>
            <BlogFilters
              tags={sortedTags}
              archive={archiveTree}
              total={allBlogs.length}
              variant="desktop"
            />
          </Card>
        </div>
      </aside>

      {/* 文章列表 */}
      <section>
        <div
          class="border-border mb-6 flex items-center justify-between border-b-2 pb-3"
        >
          <h2 class="font-heading text-2xl tracking-widest">ARTICLES</h2>
          <p class="text-foreground-secondary text-sm">
            共 <span id="showing-count" class="text-accent font-bold"
              >{allBlogs.length}</span
            > 篇
          </p>
        </div>

        <div id="posts-container" class="min-h-[50vh] space-y-4">
          {
            allBlogs.map((blog) => {
              const cleanBody = removeMarkdown(blog.body ?? "");
              const snippet =
                cleanBody.slice(0, 150) + (cleanBody.length > 150 ? "…" : "");

              return (
                <article
                  class="blog-post-item"
                  data-tags={JSON.stringify(blog.data.tags)}
                  data-date={monthKey(blog.data.date)}
                >
                  <a
                    href={`/blog/${blog.data.slug}`}
                    class="card group relative block p-4 md:p-6"
                  >
                    <span class="card-notch" aria-hidden="true" />
                    {blog.data.pinned && (
                      <span
                        class="bg-accent font-heading absolute -top-2.5 left-4 -skew-x-12 border border-black px-2 py-0.5 text-xs tracking-widest text-white"
                        aria-label="置顶"
                      >
                        PINNED
                      </span>
                    )}

                    <div class="grid grid-cols-1 gap-2 md:grid-cols-4 md:gap-6">
                      <time
                        datetime={blog.data.date.toISOString()}
                        class="text-foreground-secondary font-mono text-sm md:col-span-1"
                      >
                        {blog.data.date.toLocaleDateString("en-GB", {
                          year: "numeric",
                          month: "short",
                          day: "numeric",
                        })}
                      </time>

                      <div class="md:col-span-3">
                        <h3 class="font-heading text-foreground group-hover:text-accent text-xl tracking-wide transition-colors">
                          {blog.data.title}
                        </h3>

                        <p class="text-foreground-secondary mt-2 line-clamp-2 text-sm">
                          {snippet || blog.data.description}
                        </p>

                        <div class="mt-3 flex flex-wrap items-center gap-2">
                          {blog.data.tags.map((tag) => (
                            <Tag name={tag} />
                          ))}
                        </div>
                      </div>
                    </div>
                  </a>
                </article>
              );
            })
          }

          <div id="no-posts" class="hidden py-20 text-center">
            <p class="text-foreground-secondary text-lg">
              没有符合当前筛选条件的文章。
            </p>
            <button
              id="clear-filters"
              class="border-foreground hover:bg-accent hover:border-accent mt-4 -skew-x-12 border-2 px-4 py-1 text-sm font-bold transition-all hover:text-white"
            >
              <span class="block skew-x-12">清除全部筛选</span>
            </button>
          </div>
        </div>
      </section>
    </div>
  </div>

  {/* 移动端筛选入口 */}
  <button
    id="mobile-filter-btn"
    class="border-foreground bg-accent fixed bottom-4 left-4 z-40 flex items-center gap-1.5 border-2 px-3.5 py-2 text-white shadow-[3px_3px_0_var(--foreground)] lg:hidden"
    aria-label="筛选"
  >
    <IconFilter class="h-4 w-4 stroke-current stroke-1" />
    <span class="text-xs font-bold">筛选</span>
  </button>

  <div
    id="mobile-filter-overlay"
    class="bg-background/95 pointer-events-none fixed inset-0 z-[60] opacity-0 backdrop-blur-sm transition-opacity duration-300 lg:hidden"
  >
    <div class="h-full overflow-y-auto p-4 pb-20">
      <div class="mb-4 flex items-center justify-between">
        <h2 class="font-heading text-accent m-0 text-xl tracking-widest">
          FILTERS
        </h2>
        <button
          id="mobile-filter-close"
          class="border-border hover:border-accent border-2 p-2 transition-colors"
          aria-label="关闭筛选"
        >
          <IconX class="stroke-foreground h-5 w-5" />
        </button>
      </div>

      <BlogFilters
        tags={sortedTags}
        archive={archiveTree}
        total={allBlogs.length}
        variant="mobile"
      />
    </div>
  </div>
</BaseLayout>

<script>
  // 单一事实来源：两套面板（桌面侧栏 + 移动 overlay）里的按钮共享同一份状态，
  // 每次变更后由 syncUI() 统一刷新两边的 .active，避免激活态分叉。
  let currentTag = "all";
  let currentDate = "all";

  function initBlogFilters() {
    const container = document.getElementById("posts-container");
    if (!container) return;
    if (container.dataset.bound === "true") return;
    container.dataset.bound = "true";

    const posts = document.querySelectorAll<HTMLElement>(".blog-post-item");
    const noPosts = document.getElementById("no-posts");
    const showingCount = document.getElementById("showing-count");

    // URL 是初始筛选状态的唯一事实来源（?tag=Pwn&date=2026-03）——
    // 文章页的标签贴纸带参跳过来、收藏/分享的筛选链接都从这里进
    {
      const params = new URLSearchParams(location.search);
      const tag = params.get("tag");
      const date = params.get("date");
      // 校验参数确实存在对应按钮，乱值回落 all
      currentTag =
        tag &&
        document.querySelector(`.blog-tag[data-tag="${CSS.escape(tag)}"]`)
          ? tag
          : "all";
      currentDate =
        date &&
        document.querySelector(`.date-filter[data-date="${CSS.escape(date)}"]`)
          ? date
          : "all";
      if (currentDate !== "all") expandYear(currentDate.split("-")[0]);
    }

    function matchesDate(postDate: string) {
      if (currentDate === "all") return true;
      // 四位是年份，否则是 YYYY-MM
      if (currentDate.length === 4) return postDate.startsWith(currentDate);
      return postDate === currentDate;
    }

    function applyFilters() {
      let visible = 0;

      posts.forEach((post) => {
        const tags: string[] = JSON.parse(post.dataset.tags || "[]");
        const tagOk = currentTag === "all" || tags.includes(currentTag);
        const dateOk = matchesDate(post.dataset.date || "");

        const show = tagOk && dateOk;
        post.style.display = show ? "" : "none";
        if (show) visible++;
      });

      if (noPosts) noPosts.classList.toggle("hidden", visible !== 0);
      if (showingCount) showingCount.textContent = String(visible);

      syncUI();
      syncURL();
    }

    // 筛选状态写回地址栏 —— 可分享/可收藏。
    // 用 replaceState 而非 pushState：外来历史条目会让 ClientRouter
    // 在后退时整页重载（后退回到上一页面，而不是上一个筛选状态）
    function syncURL() {
      const params = new URLSearchParams();
      if (currentTag !== "all") params.set("tag", currentTag);
      if (currentDate !== "all") params.set("date", currentDate);
      const query = params.toString();
      history.replaceState(
        history.state,
        "",
        query ? `${location.pathname}?${query}` : location.pathname,
      );
    }

    function syncUI() {
      // 标签：两套面板一起刷
      document
        .querySelectorAll<HTMLElement>(".blog-tag")
        .forEach((btn) =>
          btn.classList.toggle("active", btn.dataset.tag === currentTag),
        );

      // 时间：年 / 月按钮同理
      document
        .querySelectorAll<HTMLElement>(".date-filter")
        .forEach((btn) =>
          btn.classList.toggle("active", btn.dataset.date === currentDate),
        );

      // 清除按钮仅在该维度有筛选时可见
      toggleClearBtn("clear-tags-filter", currentTag !== "all");
      toggleClearBtn("clear-tags-filter-mobile", currentTag !== "all");
      toggleClearBtn("clear-date-filter", currentDate !== "all");
      toggleClearBtn("clear-date-filter-mobile", currentDate !== "all");
    }

    function toggleClearBtn(id: string, visible: boolean) {
      const btn = document.getElementById(id);
      if (!btn) return;
      btn.classList.toggle("invisible", !visible);
      btn.classList.toggle("opacity-0", !visible);
    }

    // 手风琴：只展开目标年份，其余收起（两套面板同步）
    function expandYear(year: string) {
      document.querySelectorAll<HTMLElement>(".year-group").forEach((group) => {
        const toggle = group.querySelector<HTMLElement>(".year-button");
        const list = group.querySelector<HTMLElement>(".month-list");
        if (!toggle || !list) return;
        const open = group.dataset.year === year;
        toggle.dataset.expanded = String(open);
        list.style.display = open ? "" : "none";
      });
    }

    // 标签点击（事件委托，覆盖两套面板）。
    // 挂 body 而不是 document：ClientRouter 换页会整体替换 body，
    // 旧监听随之消亡，重访 /blog 重绑时不会累积
    document.body.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLElement>(
        ".blog-tag",
      );
      if (!target) return;
      currentTag = target.dataset.tag || "all";
      applyFilters();
    });

    // 时间点击：年按钮同时负责展开/收起
    document.body.addEventListener("click", (event) => {
      const target = (event.target as HTMLElement | null)?.closest<HTMLElement>(
        ".date-filter",
      );
      if (!target) return;

      currentDate = target.dataset.date || "all";

      // 年份和月份都把所属年份展开（"All Posts" 不动折叠状态）
      if (currentDate !== "all") expandYear(currentDate.split("-")[0]);

      applyFilters();
    });

    document.getElementById("clear-filters")?.addEventListener("click", () => {
      currentTag = "all";
      currentDate = "all";
      applyFilters();
    });

    document
      .getElementById("clear-tags-filter")
      ?.addEventListener("click", () => {
        currentTag = "all";
        applyFilters();
      });
    document
      .getElementById("clear-tags-filter-mobile")
      ?.addEventListener("click", () => {
        currentTag = "all";
        applyFilters();
      });
    document
      .getElementById("clear-date-filter")
      ?.addEventListener("click", () => {
        currentDate = "all";
        applyFilters();
      });
    document
      .getElementById("clear-date-filter-mobile")
      ?.addEventListener("click", () => {
        currentDate = "all";
        applyFilters();
      });

    // 移动端 overlay
    const overlay = document.getElementById("mobile-filter-overlay");
    const openBtn = document.getElementById("mobile-filter-btn");
    const closeBtn = document.getElementById("mobile-filter-close");

    function setOverlay(open: boolean) {
      if (!overlay) return;
      overlay.classList.toggle("opacity-0", !open);
      overlay.classList.toggle("pointer-events-none", !open);
      document.documentElement.style.overflow = open ? "hidden" : "";
    }

    openBtn?.addEventListener("click", () => setOverlay(true));
    closeBtn?.addEventListener("click", () => setOverlay(false));

    applyFilters();
  }

  document.addEventListener("DOMContentLoaded", initBlogFilters);
  document.addEventListener("astro:page-load", initBlogFilters);
</script>
