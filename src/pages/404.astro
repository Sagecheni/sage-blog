---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import notFoundImage from "../assets/images/404.png";
---

<BaseLayout
  title="404｜贤者工坊"
  description="没有找到该页面"
  author="SageChen"
  url="https://blog.sagec.fun/404"
>
  <div
    class="mx-auto flex min-h-[60vh] max-w-[1280px] flex-col items-center justify-center gap-8 px-4 py-16"
  >
    <Image
      src={notFoundImage}
      alt="没有找到该页面"
      class="border-border h-auto w-full max-w-[600px] border-2 object-cover shadow-[8px_8px_0_var(--accent)]"
    />

    <h1
      class="font-heading text-foreground text-4xl tracking-widest md:text-5xl"
    >
      404 — 没有找到该页面
    </h1>

    <a
      href="/"
      class="border-foreground hover:bg-accent hover:border-accent -skew-x-12 border-2 px-8 py-2 text-lg font-bold transition-all duration-200 hover:-translate-y-0.5 hover:text-white"
    >
      <span class="block skew-x-12">返回首页</span>
    </a>
  </div>
</BaseLayout>
