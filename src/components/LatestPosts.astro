---
import { getPublishedBlogs, readTimeOf } from "../data/blog";

export interface Props {
  /** 最多显示几篇 / cap on rendered rows */
  limit?: number;
}

const { limit = 6 } = Astro.props;

// 共享数据层：定时发布过滤 + CJK 感知的 readTime，与文章页同一来源
const published = await getPublishedBlogs();
const posts = published.slice(0, limit).map((blog) => ({
  slug: blog.data.slug,
  title: blog.data.title,
  date: blog.data.date,
  readTime: readTimeOf(blog),
}));
---

<div class="post-list flex flex-col gap-1">
  {
    posts.map((post, index) => (
      <a href={`/blog/${post.slug}`} class="latest-post-row">
        <span class="bloom" aria-hidden="true" />
        <span class="post-index" aria-hidden="true">
          {String(index + 1).padStart(2, "0")}
        </span>
        <h3
          class="post-title m-0 text-base"
          transition:name={`post-title-${post.slug}`}
        >
          {post.title}
        </h3>
        <span class="post-date font-mono whitespace-nowrap">
          <time datetime={post.date.toISOString()}>
            {post.date.toLocaleDateString("en-GB", {
              day: "numeric",
              month: "short",
              year: "numeric",
            })}
          </time>
          <span aria-hidden="true"> · </span>
          {post.readTime} min
        </span>
      </a>
    ))
  }
</div>
