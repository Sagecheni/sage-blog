---
const { page } = Astro.props;
import IconChevronRight from "../assets/icons/chevron-right.svg";
import IconChevronLeft from "../assets/icons/chevron-right.svg";
---

<nav class="my-3 flex items-center justify-center gap-8 select-none">
  <a
    href={page.url.prev || "#"}
    aria-label="Go to previous page"
    aria-disabled={!page.url.prev ? "true" : undefined}
    tabindex={!page.url.prev ? "-1" : undefined}
    class:list={[
      "group -skew-x-6 border px-3 py-1 transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)]",
      page.url.prev
        ? "border-foreground/40 hover:border-accent hover:bg-accent hover:text-background focus-visible:outline-accent hover:-translate-y-0.5 hover:shadow-[2px_2px_0px_var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-2"
        : "border-foreground/25 text-foreground/60 pointer-events-none cursor-not-allowed",
    ]}
  >
    <span class="flex skew-x-6 items-center gap-1.5">
      <IconChevronLeft
        class:list={[
          "stroke-current transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)]",
          page.url.prev
            ? "size-0 -translate-x-1 rotate-180 group-hover:size-5 group-hover:translate-x-0"
            : "size-4 rotate-180 opacity-50",
        ]}
      />
      <span
        class:list={[
          "transition-transform duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)]",
          page.url.prev ? "group-hover:-translate-x-1" : "",
        ]}
      >
        上一页
      </span>
    </span>
  </a>

  <p class="font-mono text-sm opacity-90">
    {page.currentPage} / {page.lastPage}
  </p>

  <a
    href={page.url.next || "#"}
    aria-label="Go to next page"
    aria-disabled={!page.url.next ? "true" : undefined}
    tabindex={!page.url.next ? "-1" : undefined}
    class:list={[
      "group -skew-x-6 border px-3 py-1 transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)]",
      page.url.next
        ? "border-foreground/40 hover:border-accent hover:bg-accent hover:text-background focus-visible:outline-accent hover:-translate-y-0.5 hover:shadow-[2px_2px_0px_var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-2"
        : "border-foreground/25 text-foreground/60 pointer-events-none cursor-not-allowed",
    ]}
  >
    <span class="flex skew-x-6 items-center gap-1.5">
      <span
        class:list={[
          "transition-transform duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)]",
          page.url.next ? "group-hover:translate-x-1" : "",
        ]}
      >
        下一页
      </span>
      <IconChevronRight
        class:list={[
          "stroke-current transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)]",
          page.url.next
            ? "size-0 translate-x-1 group-hover:size-5 group-hover:translate-x-0"
            : "size-4 opacity-50",
        ]}
      />
    </span>
  </a>
</nav>
