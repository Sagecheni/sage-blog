---
import IconCalendarWeek from "../assets/icons/calendar-week.svg";
import IconClockHour3 from "../assets/icons/clock-hour-3.svg";
import IconTag from "../assets/icons/tag.svg";
import CopyButton from "./CopyButton";
import Tag from "./Tag.astro";

const { frontmatter, readTime, modDate } = Astro.props;

const formatDate = (date: Date) =>
  date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<header class="mb-10">
  {/* 斜切红条 —— P5R 的标题起手式 */}
  <div class="mb-4 flex items-center gap-3" aria-hidden="true">
    <span class="bg-accent block h-1.5 w-16 -skew-x-12"></span>
    <span class="bg-foreground block h-1.5 w-4 -skew-x-12"></span>
  </div>

  <h1 class="blog-title font-heading text-foreground">
    {frontmatter.title}
  </h1>

  {
    frontmatter.description && (
      <p class="text-foreground-secondary mt-3 text-base">
        {frontmatter.description}
      </p>
    )
  }

  <div
    class="border-border mt-5 flex flex-col items-start justify-between gap-3 border-t-2 pt-4 select-none sm:flex-row sm:items-center"
  >
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      {/* 日期 */}
      <div class="group flex items-center gap-2">
        <IconCalendarWeek
          class="stroke-foreground-secondary group-hover:stroke-accent size-4 stroke-1 transition-colors"
        />
        <p class="text-foreground-secondary font-mono text-sm">
          {formatDate(frontmatter.date)}
          {
            modDate && (
              <span
                class="text-accent/80"
                title={`最后更新：${formatDate(modDate)}`}
              >
                {" "}
                · 更新于 {formatDate(modDate)}
              </span>
            )
          }
        </p>
      </div>

      {/* 阅读时长 */}
      <div class="group flex items-center gap-2">
        <IconClockHour3
          class="stroke-foreground-secondary group-hover:stroke-accent size-4 stroke-1 transition-colors"
        />
        <p class="text-foreground-secondary font-mono text-sm">
          {readTime} min read
        </p>
      </div>

      {/* 标签 */}
      {
        frontmatter.tags?.length > 0 && (
          <div class="flex items-center gap-2">
            <IconTag class="stroke-foreground-secondary size-4 stroke-1" />
            <div class="flex flex-wrap gap-2">
              {frontmatter.tags.map((tag: string) => (
                <Tag name={tag} href={`/blog?tag=${encodeURIComponent(tag)}`} />
              ))}
            </div>
          </div>
        )
      }
    </div>

    {/* 按钮文案不该进搜索索引 */}
    <div data-pagefind-ignore>
      <CopyButton client:idle />
    </div>
  </div>
</header>
