---
const { frontmatter, readTime } = Astro.props;
import IconCalendarWeek from "../assets/icons/calendar-week.svg";
import IconClockHour3 from "../assets/icons/clock-hour-3.svg";
import IconTag from "../assets/icons/tag.svg";
import CopyButton from "../components/CopyButton";
---

<h1 class="blog-title">
  {frontmatter.title}
</h1>
<div
  class="flex flex-col items-start justify-between gap-3 select-none sm:flex-row"
>
  <div class="mt-2 space-y-1">
    <div class="flex gap-8">
      <!-- Date -->
      <div
        class="group flex items-center gap-2 transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)] hover:-translate-y-0.5"
      >
        <IconCalendarWeek
          class="stroke-foreground group-hover:stroke-accent size-5 stroke-1 transition-colors duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)]"
        />
        <p
          class="font-mono text-base opacity-90 transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)] group-hover:font-semibold group-hover:opacity-100"
        >
          {
            frontmatter.date
              .toLocaleDateString("en-GB", {
                day: "numeric",
                month: "short",
                year: "numeric",
              })
              .slice(0, 11)
          }
        </p>
      </div>

      <!-- Read time -->
      <div
        class="group flex items-center gap-2 transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)] hover:-translate-y-0.5"
      >
        <IconClockHour3
          class="stroke-foreground group-hover:stroke-accent size-5 translate-y-0.25 stroke-1 transition-colors duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)]"
        />
        <p
          class="font-mono text-base opacity-90 transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)] group-hover:font-semibold group-hover:opacity-100"
        >
          {readTime} min read
        </p>
      </div>
    </div>

    <!-- Tags -->
    <div
      class="group flex items-center gap-2 transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)] hover:-translate-y-0.5"
    >
      <IconTag
        class="fill-background stroke-foreground group-hover:fill-accent group-hover:stroke-background size-5 stroke-1 transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)]"
      />
      <div class="space-x-2">
        {
          frontmatter.tags.map((tag: string) => (
            <span class="text-base opacity-90 transition-all duration-[var(--motion-duration-fast)] ease-[var(--motion-ease-standard)] group-hover:font-semibold group-hover:opacity-100">
              {tag}
            </span>
          ))
        }
      </div>
    </div>
  </div>
  <div class="flex items-center justify-center gap-3">
    <CopyButton client:idle />
  </div>
</div>
