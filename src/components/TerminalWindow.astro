---
interface Props {
  /** 标题栏左侧的等宽小标签 / mono badge in the title bar */
  title?: string;
  class?: string;
}

const { title = "root@sage:~", class: className } = Astro.props;
---

{
  /* 终端刻意在两套主题下都保持深色 —— 终端本来就是暗的。
    调色板在下方 <style> 里以局部变量声明，不跟随全站 light/dark 令牌翻转。
    （原先用的是半透明 bg-zinc-950/80，会透出页面底色，light 主题下会变浅） */
}
<div
  class:list={["terminal group relative mx-auto w-full max-w-3xl", className]}
>
  {/* Main Container */}
  <div
    class="terminal-frame relative z-10 overflow-hidden border-2"
    style="clip-path: polygon(0 0, 100% 2%, 98% 100%, 2% 98%);"
  >
    {/* P5R Header - Skewed & Styled */}
    <div
      class="bg-accent relative flex items-center justify-between border-b-4 border-black px-6 py-3"
    >
      {/* Striped Pattern Overlay */}
      <div
        class="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,#000_25%,#000_50%,transparent_50%,transparent_75%,#000_75%,#000_100%)] bg-[length:10px_10px] opacity-10"
      >
      </div>

      {/* Title */}
      <div class="relative z-10 flex -skew-x-12 transform items-center gap-3">
        <span
          class="border border-white bg-black px-2 py-0.5 font-mono text-xs font-bold text-white"
        >
          {title}
        </span>
        <span
          class="font-heading text-xl tracking-widest text-white uppercase drop-shadow-[2px_2px_0_rgba(0,0,0,1)]"
        >
          OMNIPOTENT ORB
        </span>
      </div>

      {/* Window Controls Decoration */}
      <div class="relative z-10 flex gap-2">
        <div class="h-3 w-3 border border-white bg-black"></div>
        <div class="h-3 w-3 border border-black bg-white"></div>
        <div class="h-3 w-3 border border-white bg-black"></div>
      </div>
    </div>

    {/* Terminal Content */}
    <div
      id="terminal-content"
      class="custom-scrollbar terminal-body relative h-[500px] space-y-4 overflow-y-auto p-6 font-mono leading-relaxed"
    >
      {/* CRT Scanline & Bloom Overlay */}
      <div
        class="pointer-events-none absolute inset-0 z-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_4px,6px_100%] bg-repeat opacity-20"
      >
      </div>
      <div
        class="pointer-events-none absolute inset-0 z-0 bg-[radial-gradient(circle_800px_at_10%_20%,rgba(217,25,28,0.05),transparent)]"
      >
      </div>

      {/* Content wrapper to stay above overlays */}
      <div
        class="terminal-slot-content relative z-10 opacity-0 transition-opacity duration-300"
      >
        <slot />
      </div>
    </div>

    {/* Footer Decoration */}
    <div class="bg-accent h-2 border-t-2 border-black"></div>
  </div>
</div>

<script>
  // Simple "Typewriter" Reveal Effect
  // It finds all leaf elements (or text-heavy elements) and reveals them sequentially

  function initTerminalTypewriter() {
    const terminals = document.querySelectorAll("#terminal-content");

    terminals.forEach((terminal) => {
      // ClientRouter 初始加载会双触发（DOMContentLoaded + astro:page-load），
      // 不守卫的话元素会被二次隐藏并挂上两个 observer
      const host = terminal as HTMLElement;
      if (host.dataset.typed === "true") return;
      host.dataset.typed = "true";

      const wrapper = terminal.querySelector(".terminal-slot-content");
      if (!wrapper) return;

      // Reveal wrapper first to avoid layout shifts? No, keep it hidden until we process.
      // Actually we want hidden children.
      wrapper.classList.remove("opacity-0");

      // Find all significant distinct text blocks to animate
      // We look for elements that likely contain text content to display
      const allElements = wrapper.querySelectorAll("*");
      const textElements = Array.from(allElements).filter(
        (el): el is HTMLElement => {
          // Keep element if it has direct text content and is not just a container for other elements
          // Or if it's a leaf node
          return (
            el instanceof HTMLElement &&
            el.children.length === 0 &&
            (el.textContent?.trim().length || 0) > 0
          );
        },
      );

      // Prepare elements: hide them
      textElements.forEach((el) => {
        el.classList.add("opacity-0", "translate-y-2");
        el.style.transition = "opacity 0.2s ease-out, transform 0.2s ease-out";
      });

      // Animate them one by one
      let delay = 0;
      const interval = 30; // ms between lines

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              textElements.forEach((el) => {
                setTimeout(() => {
                  el.classList.remove("opacity-0", "translate-y-2");
                }, delay);
                delay += interval;
              });
              observer.disconnect(); // Only run once
            }
          });
        },
        { threshold: 0.1 },
      );

      observer.observe(terminal);
    });
  }

  // Run on load and View Transitions
  document.addEventListener("astro:page-load", initTerminalTypewriter);
  document.addEventListener("DOMContentLoaded", initTerminalTypewriter);
</script>

<style>
  /* 终端自带的一套固定深色调色板：不随全站 light/dark 翻转，
     所以它在两套主题下长得完全一样 */
  .terminal {
    --term-bg: #0b0b0d;
    --term-border: #52525b;
    --term-text: #d4d4d8;
    --term-scroll-track: #000000;
  }

  .terminal-frame {
    background-color: var(--term-bg);
    border-color: var(--term-border);
    /* 原来用的是 drop-shadow(...rgba(0,0,0,1))，在黑底上等于看不见 */
    box-shadow: 8px 8px 0 var(--accent);
  }

  .terminal-body {
    color: var(--term-text);
  }

  /* P5R Red Scrollbar */
  .custom-scrollbar::-webkit-scrollbar {
    width: 12px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: var(--term-scroll-track);
    border-left: 1px solid #333;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--accent);
    border: 2px solid var(--term-scroll-track);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #ff0015;
  }
</style>
